# Copy to config/remicsdev/.env.inbound-imap.local (gitignored) and fill in.
# Do not commit real secrets.

INBOUND_IMAP_HOST=outlook.office365.com
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=jscott@fcsa.ca
INBOUND_IMAP_AUTH=xoauth2

# Entra app (single-tenant) used for client-credentials IMAP
INBOUND_TENANT_ID=
INBOUND_CLIENT_ID=
INBOUND_CLIENT_SECRET=

# Token scope for IMAP application permission IMAP.AccessAsApp
INBOUND_TOKEN_SCOPE=https://outlook.office365.com/.default
